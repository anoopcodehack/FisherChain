# Deployed Contract Address (defaults to Hardhat local node if empty)
REACT_APP_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Fallback JSON-RPC URL for read-only consumer queries
REACT_APP_RPC_URL=http://127.0.0.1:8545

# Pinata IPFS Gateway & JWT
REACT_APP_PINATA_JWT=your_pinata_jwt_here
REACT_APP_PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs

# Off-chain Backend API URL
REACT_APP_API_URL=http://localhost:5000/api
